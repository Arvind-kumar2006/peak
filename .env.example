# Model providers, in fallback order — see agent/README.md. Providers without a key are skipped.
MODEL_PROVIDERS=groq,gemini,openai,xai   # use "mock" for the scripted local model
GROQ_API_KEY=                   # groq.com, starts with gsk_ (NOT xAI's Grok)
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=http://localhost:7310/v1   # through agent/model-proxy.mjs — required for Groq
GEMINI_API_KEY=                 # aistudio.google.com
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.2            # set to a model your OpenAI account has
XAI_API_KEY=                    # x.ai Grok, starts with xai-
XAI_MODEL=grok-4                # set to a model your xAI account has

# MCP servers (P2) — MOCK=1 uses the shared simulated world instead of real APIs
MOCK=1
DB_MCP_URL=http://localhost:7101/mcp
CLOUD_MCP_URL=http://localhost:7102/mcp
GITHUB_MCP_URL=http://localhost:7103/mcp
REPORT_MCP_URL=http://localhost:7104/mcp
MOCK_MODEL_URL=http://localhost:7300/v1

# Service URLs (local defaults — see contracts/README.md for ports)
TRUEFORGE_URL=http://localhost:8790
DEMO_APP_URL=http://localhost:3000
BACKEND_URL=http://localhost:4000

# Demo app / DB (P1)
DATABASE_URL=
SENTRY_DSN=
ADMIN_TOKEN=change-me

# Cloud (P1/P2)
RENDER_API_KEY=
RENDER_SERVICE_ID=

# GitHub (P2)
GITHUB_TOKEN=
GITHUB_REPO=owner/demo-repo

# Sentry API (P2)
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
