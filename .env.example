# ——— PEAK server ———
PORT=4000
DATABASE_URL=                          # Postgres (e.g. Neon). Empty = local PGlite under data/pglite
TRUST_PROXY=0                          # set to 1 only behind a reverse proxy that sets X-Forwarded-For
APP_URL=http://localhost:5173          # where people open PEAK (Slack links, GitHub OAuth callback)
SERVER_URL=http://localhost:4000       # how TrueForge reaches PEAK's MCP endpoint
APP_SECRET=                            # encrypts stored tokens; generated and kept in data/ if empty

# ——— GitHub OAuth App: "Connect with GitHub" (per user) and "Sign in with GitHub" ———
# OAuth App callback URL: <APP_URL>/api/auth/github/callback
# GitHub is OAuth-only: there is no token field in the UI, and the server refuses a
# connection that did not come from this callback.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ——— Slack app: "Connect with Slack" (per workspace) ———
# Create the app from a manifest (api.slack.com/apps → Create New App → From a manifest),
# paste this, then set the Redirect URL to <APP_URL>/api/auth/slack/callback and install
# the app on your workspace. No bot token is ever pasted into PEAK.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
# ——— Slack Approve/Reject buttons (optional) ———
# Interactivity Request URL: <public APP_URL>/api/slack/interactions
# Without it, Slack messages link to PEAK for approval.
SLACK_SIGNING_SECRET=
# Bot scopes PEAK asks for. The defaults post and update incident messages, list channels,
# and join the one the user picks. Add channels:history if you want PEAK to read replies.
SLACK_SCOPES=chat:write,channels:read,groups:read,channels:join,groups:join

# ——— Monitoring ———
MONITOR_INTERVAL_SEC=10
ERROR_THRESHOLD_PER_MIN=5              # open an incident at this many Sentry events/min
FAILED_CHECKS_TO_ALERT=2               # … or this many failed health checks in a row
VERIFY_WINDOW_SEC=30                   # after the fix, stay clean this long to count as resolved
VERIFY_DEPLOY_TIMEOUT_SEC=600          # max wait for the revert to show up in the health endpoint's release
INCIDENT_RETENTION_DAYS=90
MERGE_POLL_SEC=30                      # code-fix pull requests: how often to check for the merge
MERGE_TIMEOUT_HOURS=72                 # … and when to give up and hand the incident to a human             # closed incidents older than this are deleted (0 = keep forever)

# ——— Agent runtime (TrueForge) ———
TRUEFORGE_URL=http://localhost:8790

# Model providers in fallback order. Providers without a key are skipped.
MODEL_PROVIDERS=truefoundry,groq,gemini,openai,xai
TRUEFOUNDRY_API_KEY=                   # TrueFoundry AI Gateway token (custom provider "gpt-model")
TRUEFOUNDRY_BASE_URL=https://gateway.truefoundry.ai
TRUEFOUNDRY_MODEL=vm-polaris/openai
GROQ_API_KEY=                          # groq.com, starts with gsk_
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=http://localhost:7310/v1 # through server/model/groq-proxy.js (npm run dev starts it)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.2
XAI_API_KEY=                           # x.ai Grok, starts with xai-
XAI_MODEL=grok-4
