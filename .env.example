# ——— PEAK server ———
PORT=4000
APP_URL=http://localhost:5173          # where people open PEAK (Slack links, GitHub OAuth callback)
SERVER_URL=http://localhost:4000       # how TrueForge reaches PEAK's MCP endpoint
APP_SECRET=                            # encrypts stored tokens; generated and kept in data/ if empty

# ——— Sign in with GitHub (optional; email + password always works) ———
# OAuth App callback URL: <APP_URL>/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ——— Slack Approve/Reject buttons (optional) ———
# Interactivity Request URL: <public APP_URL>/api/slack/interactions
# Without it, Slack messages link to PEAK for approval.
SLACK_SIGNING_SECRET=

# ——— Connections from .env (optional) ———
# Auto-connected for every workspace that hasn't connected its own on the Connections page.
GITHUB_TOKEN=                          # fine-grained PAT: Contents read & write, Metadata read
GITHUB_REPO=                           # owner/repo
GITHUB_BRANCH=                         # default branch if empty
SENTRY_AUTH_TOKEN=                     # USER token (sntryu_…): project:read, event:read, org:read
SENTRY_ORG=
SENTRY_URL=https://sentry.io           # https://de.sentry.io for the EU region
SLACK_BOT_TOKEN=                       # xoxb-…, chat:write; or use SLACK_WEBHOOK_URL
SLACK_CHANNEL=
SLACK_WEBHOOK_URL=
SERVICE_NAME=                          # first service to watch, added if a workspace has none
SERVICE_HEALTH_URL=
SENTRY_PROJECT=

# ——— Monitoring ———
MONITOR_INTERVAL_SEC=10
ERROR_THRESHOLD_PER_MIN=5              # open an incident at this many Sentry events/min
FAILED_CHECKS_TO_ALERT=2               # … or this many failed health checks in a row
VERIFY_WINDOW_SEC=30                   # after the fix, stay clean this long to count as resolved
VERIFY_DEPLOY_TIMEOUT_SEC=600          # max wait for the revert to show up in the health endpoint's release

# ——— Agent runtime (TrueForge) ———
TRUEFORGE_URL=http://localhost:8790

# Model providers in fallback order. Providers without a key are skipped.
MODEL_PROVIDERS=truefoundry,groq,gemini,openai,xai
TRUEFOUNDRY_API_KEY=                   # TrueFoundry AI Gateway token (custom provider "gpt-model")
TRUEFOUNDRY_BASE_URL=https://gateway.truefoundry.ai
TRUEFOUNDRY_MODEL=vm-polaris/openai
GROQ_API_KEY=                          # groq.com, starts with gsk_
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=http://localhost:7310/v1 # through server/model/groq-proxy.js (npm run dev starts it)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.2
XAI_API_KEY=                           # x.ai Grok, starts with xai-
XAI_MODEL=grok-4
