# Model — OpenAI primary, Grok (xAI) fallback. See agent/lib/providers.mjs
MODEL_PROVIDERS=openai,xai      # fallback order; use "mock" for the scripted local model
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.2            # set to a model your OpenAI account has
XAI_API_KEY=
XAI_MODEL=grok-4                # set to a model your xAI account has

# Service URLs (local defaults — see contracts/README.md for ports)
TRUEFORGE_URL=http://localhost:8790
DEMO_APP_URL=http://localhost:3000
BACKEND_URL=http://localhost:4000

# Demo app / DB (P1)
DATABASE_URL=
SENTRY_DSN=
ADMIN_TOKEN=change-me

# Cloud (P1/P2)
RENDER_API_KEY=
RENDER_SERVICE_ID=

# GitHub (P2)
GITHUB_TOKEN=
GITHUB_REPO=owner/demo-repo

# Sentry API (P2)
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
