# P1 — demo app configuration. Copy to the repo-root .env (shared by all services).

# --- required ---
PORT=3000
# Direct (non-pooled) connection string. See README: a pgbouncer/pooler URL
# breaks pg_stat_activity and idle-in-transaction, which is exactly the evidence
# Scenario A depends on.
DATABASE_URL=
ADMIN_TOKEN=change-me

# --- release identity ---
# Render sets RENDER_GIT_COMMIT per deploy. Leave unset locally.
# RENDER_GIT_COMMIT=
# RENDER_INSTANCE_ID=

# --- pool ---
# 10 matches contracts/demo-app-api.md. Do not change without a contract PR.
POOL_MAX=10
# Without this a saturated pool hangs forever and we never see the 500s.
POOL_CONNECT_TIMEOUT_MS=2000
POOL_IDLE_TIMEOUT_MS=10000

# --- metrics windows ---
# errorRate is a fraction (0-1) over this window. Contract says 60.
# Drop to 20 if you want "resolved" to land sooner after a rollback: a 60s
# rolling window plus a 60s stability check means up to ~2min to declare.
ERROR_RATE_WINDOW_SEC=60
LATENCY_WINDOW_SEC=60
# Must match the Render instance memory so "near limit" means what it says.
MEMORY_LIMIT_MB=512

# --- Scenario A pacing ---
# Leaks one client per tick, so the pool saturates in
# ~POOL_MAX * RECONCILE_INTERVAL_SEC (10 * 6 = 60s by default).
RECONCILE_INTERVAL_SEC=6
RECONCILE_PAGES=3

# --- Scenario B ---
CACHE_MAX_ENTRIES=2000
CACHE_ENTRY_KB=160
CACHE_GROWTH_EVERY_N=1

# --- background traffic (the normal demo path) ---
TRAFFIC_ENABLED=false
TRAFFIC_RPS=8
TRAFFIC_PATH=/orders?limit=20&offset=0

# --- observability ---
LOG_LEVEL=info
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=local
