{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PEAK incident reports",
  "description": "GENERATED from agent/report-schema.mjs (npm run schema in agent/) — do not edit by hand. The agent submits these as arguments to report-mcp tools; the backend reads them with getReports() from agent/lib/trueforge-client.mjs.",
  "definitions": {
    "Diagnosis": {
      "description": "submit_diagnosis arguments — available while the action awaits approval",
      "type": "object",
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 1,
          "description": "One or two sentences for the dashboard headline"
        },
        "rootCause": {
          "type": "object",
          "properties": {
            "category": {
              "type": "string",
              "enum": [
                "code",
                "infra",
                "unknown"
              ]
            },
            "description": {
              "type": "string",
              "minLength": 1,
              "description": "The causal chain: cause → mechanism → symptom"
            },
            "confidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "commitSha": {
              "type": [
                "string",
                "null"
              ],
              "description": "Offending commit (short or full SHA) when category = code, else null"
            }
          },
          "required": [
            "category",
            "description",
            "confidence",
            "commitSha"
          ],
          "additionalProperties": false
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "claim": {
                "type": "string",
                "minLength": 1,
                "description": "What this evidence supports"
              },
              "tool": {
                "type": "string",
                "minLength": 1,
                "description": "Tool that produced it, e.g. db-mcp.get_pool_stats"
              },
              "observation": {
                "type": "string",
                "minLength": 1,
                "description": "The concrete value(s) observed, quoted from the tool result"
              }
            },
            "required": [
              "claim",
              "tool",
              "observation"
            ],
            "additionalProperties": false
          },
          "minItems": 2
        },
        "ruledOut": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Alternative causes checked and rejected, each with the reason"
        },
        "proposedFix": {
          "type": "object",
          "properties": {
            "action": {
              "type": "string",
              "enum": [
                "trigger_rollback",
                "restart_service",
                "scale_service",
                "clear_cache",
                "none"
              ]
            },
            "args": {
              "type": "object",
              "additionalProperties": {},
              "description": "Exact arguments you will pass to the action tool"
            },
            "reasoning": {
              "type": "string",
              "minLength": 1,
              "description": "Why this action fixes the root cause (not just the symptom)"
            },
            "expectedOutcome": {
              "type": "string",
              "enum": [
                "resolves",
                "mitigates"
              ],
              "description": "resolves = removes the root cause; mitigates = clears symptoms only"
            }
          },
          "required": [
            "action",
            "args",
            "reasoning",
            "expectedOutcome"
          ],
          "additionalProperties": false
        },
        "before": {
          "type": "object",
          "properties": {
            "errorRate": {
              "type": [
                "number",
                "null"
              ]
            },
            "p95Ms": {
              "type": [
                "number",
                "null"
              ]
            },
            "poolInUse": {
              "type": [
                "number",
                "null"
              ]
            },
            "poolWaiting": {
              "type": [
                "number",
                "null"
              ]
            },
            "memoryMB": {
              "type": [
                "number",
                "null"
              ]
            },
            "release": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "errorRate",
            "p95Ms",
            "poolInUse",
            "poolWaiting",
            "memoryMB",
            "release"
          ],
          "additionalProperties": false,
          "description": "Key metrics observed during the incident"
        }
      },
      "required": [
        "summary",
        "rootCause",
        "evidence",
        "ruledOut",
        "proposedFix",
        "before"
      ],
      "additionalProperties": false
    },
    "Resolution": {
      "description": "submit_resolution arguments — the final verdict after verification",
      "type": "object",
      "properties": {
        "verdict": {
          "type": "string",
          "enum": [
            "resolved",
            "mitigated",
            "not_resolved",
            "rejected"
          ]
        },
        "actionTaken": {
          "type": "string",
          "enum": [
            "trigger_rollback",
            "restart_service",
            "scale_service",
            "clear_cache",
            "none"
          ]
        },
        "windowSec": {
          "type": "integer",
          "minimum": 0,
          "description": "Length of the verification window you checked"
        },
        "before": {
          "type": "object",
          "properties": {
            "errorRate": {
              "type": [
                "number",
                "null"
              ]
            },
            "p95Ms": {
              "type": [
                "number",
                "null"
              ]
            },
            "poolInUse": {
              "type": [
                "number",
                "null"
              ]
            },
            "poolWaiting": {
              "type": [
                "number",
                "null"
              ]
            },
            "memoryMB": {
              "type": [
                "number",
                "null"
              ]
            },
            "release": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "errorRate",
            "p95Ms",
            "poolInUse",
            "poolWaiting",
            "memoryMB",
            "release"
          ],
          "additionalProperties": false
        },
        "after": {
          "type": "object",
          "properties": {
            "errorRate": {
              "$ref": "#/properties/before/properties/errorRate"
            },
            "p95Ms": {
              "$ref": "#/properties/before/properties/p95Ms"
            },
            "poolInUse": {
              "$ref": "#/properties/before/properties/poolInUse"
            },
            "poolWaiting": {
              "$ref": "#/properties/before/properties/poolWaiting"
            },
            "memoryMB": {
              "$ref": "#/properties/before/properties/memoryMB"
            },
            "release": {
              "$ref": "#/properties/before/properties/release"
            }
          },
          "required": [
            "errorRate",
            "p95Ms",
            "poolInUse",
            "poolWaiting",
            "memoryMB",
            "release"
          ],
          "additionalProperties": false,
          "description": "Metrics at the end of the verification window"
        },
        "reasoning": {
          "type": "string",
          "minLength": 1,
          "description": "Why this verdict, citing the window samples"
        },
        "followUp": {
          "type": "string",
          "description": "What a human should do next (e.g. fix the code, investigate further); empty if nothing"
        }
      },
      "required": [
        "verdict",
        "actionTaken",
        "windowSec",
        "before",
        "after",
        "reasoning",
        "followUp"
      ],
      "additionalProperties": false
    }
  }
}
