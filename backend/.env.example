# P4 backend env. Copy to backend/.env or export before `npm start`.
# Root .env.example is the team-wide list; this file only adds P4's own keys.

# --- TrueForge (P3) ---------------------------------------------------------
TRUEFORGE_URL=http://localhost:8790

# real | fake | auto   (auto = real if TRUEFORGE_URL answers /health, else fake)
# fake replays a scripted Scenario A / B timeline with no TrueForge, no model
# and no API key. That is how the dashboard was built before the core landed.
TRUEFORGE_MODE=auto

# Agent registered by P3's setup script. Used for POST /sessions.
# If P3 registers a different name, set this — nothing else changes.
TRUEFORGE_AGENT_NAME=incident-investigator

# How often the background poller reads turn events. The dashboard polls us
# every 2s; this is deliberately faster so a 2s dashboard poll never shows a
# stale status. Too low and we hammer TrueForge during a long investigation.
POLL_INTERVAL_MS=1500

# --- Demo app (P1) ----------------------------------------------------------
DEMO_APP_URL=http://localhost:3000
# Sent as x-admin-token to /admin/inject and /admin/reset.
ADMIN_TOKEN=change-me

# --- Storage ----------------------------------------------------------------
# PEAK_DATABASE_URL is a Neon connection string. P1 owns DATABASE_URL and its
# own tables, so P4 gets its own DSN and its own `peak` schema rather than
# sharing a migration surface with the service we are supposed to be debugging.
#
# Leave BOTH empty and the backend runs on the in-memory store: the full demo
# works, it just forgets incidents when the process restarts. That is the
# intended fallback until Neon is provisioned.
PEAK_DATABASE_URL=
DATABASE_URL=

# --- Server -----------------------------------------------------------------
PORT=4000
# Comma-separated origins allowed to call the API. The dashboard dev server
# proxies /api, so this only matters if something calls the backend directly.
CORS_ORIGIN=http://localhost:5173
