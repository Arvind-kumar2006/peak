# P4 backend env. Copy to backend/.env or export before `npm start`.
# Root .env.example is the team-wide list; this file only adds P4's own keys
# plus the P3 keys the backend has to be able to see.
#
# The backend loads this file into process.env at boot (src/config.js), so
# anything P3's code reads from process.env — MODEL_PROVIDERS, the MCP URLs —
# can live here too. That means you can run the whole backend from this one file.

# --- TrueForge (P3) ---------------------------------------------------------
TRUEFORGE_URL=http://localhost:8790

# real | fake | auto   (auto = real if TRUEFORGE_URL answers, else fake)
# fake replays a scripted Scenario A / B timeline with no TrueForge, no model and
# no API key. That is how the dashboard was built and demoed before the core
# landed, and it is the fastest way to rehearse a UI change.
TRUEFORGE_MODE=auto

# Display only. The AgentSpec and the incident prompt come from P3
# (agent/agent-spec.mjs) so the backend and the agent cannot drift apart.
TRUEFORGE_AGENT_NAME=incident-investigator

# How often the background poller reads session state. The dashboard polls us
# every 2s, so this is deliberately faster — a 2s dashboard poll should never
# show a status that is already stale.
POLL_INTERVAL_MS=1500

# --- Model providers (P3) --------------------------------------------------
# The backend creates the TrueForge client, so it needs a provider configured or
# it cannot build a real adapter at all. Consumed by agent/lib/providers.mjs.
#
#   openai,xai  production (default) — needs OPENAI_API_KEY and/or XAI_API_KEY
#   mock        scripted local model, no key, deterministic. Needs
#               `npm start` in agent/ (mock-model.mjs on :7300).
#
# This is also the demo's insurance: P3's client falls back to the next provider
# when a turn fails on a model error, so one provider having a bad day does not
# end the run.
MODEL_PROVIDERS=openai,xai
OPENAI_API_KEY=
# XAI_API_KEY=

# For MODEL_PROVIDERS=mock, uncomment and run agent/mock-model.mjs:
# MOCK_MODEL_URL=http://localhost:7300/v1

# --- MCP servers (P3's AgentSpec reads these) ------------------------------
DB_MCP_URL=http://localhost:7101/mcp
CLOUD_MCP_URL=http://localhost:7102/mcp
GITHUB_MCP_URL=http://localhost:7103/mcp
REPORT_MCP_URL=http://localhost:7104/mcp

# --- Demo app (P1) ----------------------------------------------------------
DEMO_APP_URL=http://localhost:3000
# Sent as x-admin-token to /admin/inject and /admin/reset.
ADMIN_TOKEN=change-me

# --- Storage ----------------------------------------------------------------
# PEAK_DATABASE_URL is a Neon connection string. P1 owns DATABASE_URL and its
# own tables, so P4 gets its own DSN and its own `peak` schema rather than
# sharing a migration surface with the service we are supposed to be debugging.
#
# Leave BOTH empty and the backend runs on the in-memory store: the full demo
# works, it just forgets incidents when the process restarts. That is the
# intended fallback until Neon is provisioned.
PEAK_DATABASE_URL=
DATABASE_URL=

# --- Server -----------------------------------------------------------------
PORT=4000
# Comma-separated origins allowed to call the API directly. The dashboard dev
# server proxies /api, so this only matters when something calls from another
# machine during a rehearsal.
CORS_ORIGIN=http://localhost:5173

# --- Scripted fake agent ----------------------------------------------------
# 3 = three times faster than the demo pacing. 0.5 = half speed. Only read when
# TRUEFORGE_MODE=fake.
FAKE_SPEED=1
